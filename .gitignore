# Guard against ever committing private key material to a repo whose whole
# purpose is public keys. Public keys and certs are still allowed through.
*_rsa
*_ed25519
*_ecdsa
*.pem
*.key
!*.pub
# Backups bootstrap.sh leaves beside a file it edits.
*.bak.[0-9]*
# Release asset, built by `git archive` at release time.
bootstrap.tar.gz
# Release asset, built by `build.sh` at release time.
install.sh
